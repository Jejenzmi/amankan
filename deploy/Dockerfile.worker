# syntax=docker/dockerfile:1
# Worker image — unlike the distroless API image, the worker needs the real
# scanner binaries (nmap, nuclei, gitleaks) on its PATH.

# --- build stage ---
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

# --- runtime stage ---
FROM debian:stable-slim

# Pinned scanner versions (override at build time with --build-arg).
ARG NUCLEI_VERSION=3.3.7
ARG GITLEAKS_VERSION=8.21.2
ARG TARGETARCH=amd64

RUN apt-get update && \
    apt-get install -y --no-install-recommends nmap ca-certificates curl unzip && \
    rm -rf /var/lib/apt/lists/*

# nuclei
RUN curl -fsSL -o /tmp/nuclei.zip \
      "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION}_linux_${TARGETARCH}.zip" && \
    unzip -o /tmp/nuclei.zip -d /usr/local/bin nuclei && rm /tmp/nuclei.zip

# gitleaks
RUN curl -fsSL -o /tmp/gitleaks.tar.gz \
      "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" && \
    tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks && rm /tmp/gitleaks.tar.gz

# Non-root runtime user.
RUN useradd -r -u 65532 -m amankan
COPY --from=build /out/worker /usr/local/bin/worker

USER 65532:65532
# Pre-warm nuclei templates at first run; worker reads the queue and scans.
ENTRYPOINT ["/usr/local/bin/worker"]
