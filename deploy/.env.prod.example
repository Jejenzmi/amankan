# Secrets for deploy/docker-compose.prod.yml. Copy to deploy/.env.prod and edit.
# Generate strong values, e.g.:  openssl rand -hex 24

POSTGRES_PASSWORD=change-me-strong
REDIS_PASSWORD=change-me-strong
NEO4J_PASSWORD=change-me-strong
KEYCLOAK_ADMIN_PASSWORD=change-me-strong

# Browser origin(s) of the dashboard (no wildcard in production).
CORS_ORIGINS=https://localhost:3000
RATE_LIMIT=20

# --- Identity: pick ONE ---
# A) OIDC / Keycloak (recommended). After Keycloak is up, the realm issuer is:
#    http://keycloak:8080/realms/amankan  (internal)  — adjust to your public URL.
OIDC_ISSUER=
OIDC_AUDIENCE=amankan-api
# B) API keys (fallback if OIDC_ISSUER is empty): "label:secret:role,..."
API_KEYS=

# Threat-intel: fetch live CISA KEV + EPSS at startup.
THREATINTEL_FETCH=true

# Global scan authorization. Leave false and authorize per-asset instead
# (POST /assets/{id}/authorize) for least privilege.
SCAN_AUTHORIZED=false
