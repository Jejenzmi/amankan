# Amankan configuration
# Mode: "development" (mock fallbacks, relaxed checks) or "production" (NO mock —
# scanners fail loudly if they can't run for real; refuses insecure config on boot).
AMANKAN_ENV=development
AMANKAN_HTTP_ADDR=:8080
AMANKAN_DATABASE_URL=postgres://amankan:amankan@localhost:5544/amankan?sslmode=disable
AMANKAN_REDIS_ADDR=localhost:6399
AMANKAN_QUEUE_KEY=amankan:scanjobs

# Scanner toggles. If a binary is missing, the adapter falls back to a deterministic mock
# so the PoC remains runnable end-to-end without the external tool installed.
AMANKAN_NMAP_BIN=nmap
AMANKAN_NUCLEI_BIN=nuclei
AMANKAN_SCAN_TIMEOUT_SECONDS=120
AMANKAN_GITLEAKS_BIN=gitleaks
# Allow real scanners to run against live targets. Off by default for safety.
AMANKAN_ALLOW_LIVE_SCAN=false
# Confirm you are AUTHORIZED to scan the registered targets. Without this, real
# scanning is restricted to loopback / RFC1918 so a misconfiguration cannot hit
# third-party hosts. Set true ONLY for assets you own or are permitted to test.
AMANKAN_SCAN_AUTHORIZED=false

# Neo4j graph (attack-path / lateral movement). Leave AMANKAN_NEO4J_URI empty to
# disable the graph component entirely; the rest of the platform still runs.
AMANKAN_NEO4J_URI=bolt://localhost:7688
AMANKAN_NEO4J_USER=neo4j
AMANKAN_NEO4J_PASS=amankanpass

# --- Security / API hardening ---
# API-key authentication + RBAC. Format: "label:secret:role,..." with role in
# viewer|analyst|admin. Leave EMPTY to disable auth (open access, dev only).
#   viewer  = read-only · analyst = +scans/status/export · admin = +graph/accounts/audit
AMANKAN_API_KEYS=
# Allowed browser origins for CORS (comma-separated; "*" = permissive dev mode).
AMANKAN_CORS_ORIGINS=http://localhost:3000
# Per-client-IP rate limit in requests/second (0 = disabled).
AMANKAN_RATE_LIMIT=0
# Optional TLS termination. Set BOTH to serve HTTPS directly; otherwise terminate
# TLS at a reverse proxy. (The DB URL should also use sslmode=require in prod.)
AMANKAN_TLS_CERT=
AMANKAN_TLS_KEY=

# --- Threat intelligence (optional external feeds) ---
# Option A: fetch live feeds over HTTP at startup (CISA KEV + FIRST.org EPSS).
AMANKAN_THREATINTEL_FETCH=false
# AMANKAN_KEV_URL / AMANKAN_EPSS_URL override the defaults if needed.
# Option B: load from local files instead (e.g. air-gapped). When neither is set,
# a small embedded KEV fallback set is used and EPSS scores are absent.
AMANKAN_KEV_FEED=
AMANKAN_EPSS_FEED=
